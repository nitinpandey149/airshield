# Configuration used by `make docker-run`.
# Copy to `.env.docker` and adjust. Never commit real credentials.

AIRSHIELD_DATA_MODE=auto
AIRSHIELD_INFERENCE_BACKEND=local

# Set this only after deploying a real SageMaker endpoint
SAGEMAKER_ENDPOINT_NAME=
AWS_REGION=us-east-1

# Ask AirShield. The image already contains the knowledge corpus and its
# retrieval index, so the assistant works with no extra configuration. With no
# LLM configured it returns retrieved source passages verbatim.
# Point these at any OpenAI-compatible /chat/completions endpoint to enable
# generated explanations.
AIRSHIELD_ASSISTANT_ENABLED=true
AIRSHIELD_LLM_BASE_URL=
AIRSHIELD_LLM_MODEL=
AIRSHIELD_LLM_API_KEY=
