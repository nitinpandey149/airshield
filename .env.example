# =============================================================================
# AirShield configuration
# Copy to `.env` and adjust. NEVER commit the real `.env` file.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# local  -> predicts with the local XGBoost artifact in ml/artifacts/
# aws    -> predicts by invoking a real SageMaker endpoint (requires AWS_* below)
AIRSHIELD_INFERENCE_BACKEND=local

# live   -> reads real measurements from Open-Meteo (public, no key required)
# demo   -> reads the bundled sample dataset, clearly labelled as DEMO in the UI
# auto   -> try live, fall back to demo and report which was used
AIRSHIELD_DATA_MODE=auto

# HTTP client behaviour for upstream data sources (seconds)
AIRSHIELD_HTTP_TIMEOUT=15
AIRSHIELD_HTTP_RETRIES=2

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins
AIRSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to the local model artifact directory (relative to repo root by default)
AIRSHIELD_ARTIFACT_DIR=ml/artifacts

# -----------------------------------------------------------------------------
# SageMaker (OPTIONAL - only needed when AIRSHIELD_INFERENCE_BACKEND=aws)
# This is the ONLY AWS AI/ML service used by this project.
# -----------------------------------------------------------------------------
# SageMaker real-time endpoint name created by ml/sagemaker/deploy.py
SAGEMAKER_ENDPOINT_NAME=
AWS_REGION=us-east-1
# Credentials are read from the standard boto3 chain (env vars, ~/.aws/credentials,
# or an instance/role profile). Do not hardcode them here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Training
# -----------------------------------------------------------------------------
# How many days of real history to pull when building the training set
AIRSHIELD_TRAIN_DAYS=60
# Where the bundled / cached training data lives
AIRSHIELD_DATA_DIR=ml/data
# Forecast horizons to train, one model each. Default matches the core HORIZONS.
AIRSHIELD_HORIZONS=1,3,6

# -----------------------------------------------------------------------------
# AWS (OPTIONAL - all of these are off by default)
# Local inference and local data work with none of these set. Each value below
# maps to one service in infra/cloudformation/airshield-pulse.yaml, and
# /api/aws/status reports exactly which are configured.
# -----------------------------------------------------------------------------
# Amazon S3 bucket for training datasets and model artifacts (CloudFormation:
# DataBucketName). Also settable as AIRSHIELD_S3_BUCKET.
AIRSHIELD_S3_BUCKET=
# Amazon DynamoDB table for location preferences, saved plans and spike events
# (CloudFormation: StateTableName).
AIRSHIELD_DYNAMODB_TABLE=
# Amazon SNS topic ARN for pollution-spike notifications (CloudFormation:
# SpikeTopicArn).
AIRSHIELD_SNS_TOPIC_ARN=
# EventBridge schedule name for the spike/ingestion pipeline (CloudFormation:
# IngestScheduleName).
AIRSHIELD_EVENTBRIDGE_SCHEDULE=
# Ingestion Lambda function name (CloudFormation: IngestFunctionName).
AIRSHIELD_LAMBDA_FUNCTION=

# -----------------------------------------------------------------------------
# Ask AirShield assistant (RAG)
# The assistant explains AirShield's own outputs and retrieves environmental
# knowledge. It never produces forecasts, AQI or exposure scores.
# -----------------------------------------------------------------------------
# Master switch for the assistant endpoints.
AIRSHIELD_ASSISTANT_ENABLED=true

# Knowledge corpus (manifest.json + sources/) and the built vector index.
AIRSHIELD_KNOWLEDGE_DIR=knowledge
AIRSHIELD_RAG_INDEX_DIR=knowledge/index

# Retrieval: how many passages to hand the model, and the minimum cosine
# similarity for a passage to count as relevant. The floor is what makes the
# assistant say "I don't know" instead of returning the least-bad match.
AIRSHIELD_RAG_TOP_K=4
AIRSHIELD_RAG_MIN_SCORE=0.22

# Embedding backend: 'semantic' (model2vec, default), 'hashing' (lexical
# fallback, no download), or a specific model2vec model name.
AIRSHIELD_RAG_EMBEDDER=semantic

# Language model. Leave both blank to run without one: the assistant then
# returns the retrieved source passages verbatim instead of generated prose.
# Any OpenAI-compatible /chat/completions endpoint works.
AIRSHIELD_LLM_BASE_URL=
AIRSHIELD_LLM_MODEL=
AIRSHIELD_LLM_API_KEY=
AIRSHIELD_LLM_TIMEOUT=45
# Optional JSON object of extra headers, e.g. {"X-Org":"team"}.
AIRSHIELD_LLM_EXTRA_HEADERS=

# -----------------------------------------------------------------------------
# Frontend (Vite) - set in frontend/.env.local
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
